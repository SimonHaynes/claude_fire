# Copy this file to .env and fill in your own key. .env is gitignored.
#
# OPTIONAL. Without it, tools/fetch_market_data.py builds everything except
# `us_recession_*.csv`, which costs you the corporate-credit model
# (retireplan.market.HeldToMaturityCredit) and nothing else -- a plan holding
# no corporate bonds does not notice. Equity, bond and inflation data all come
# from Damodaran, who needs no key.
#
# Free signup, instant key: https://fredaccount.stlouisfed.org/apikeys
# Used only by tools/fetch_market_data.py, to pull the NBER recession series
# (USREC) from the St Louis Fed's API.
#
# Use api.stlouisfed.org, not the fred.stlouisfed.org/graph CSV endpoint --
# the latter is unreliable from some networks/CI runners.
FRED_API_KEY=
